{
  "fullBookingPostRoute": {
    "tags": [
      "Bookings"
    ],
    "summary": "Create Booking",
    "operationId": "create_booking_api_v1_bookings__post",
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/BookingCreate"
          }
        }
      },
      "required": true
    },
    "responses": {
      "201": {
        "description": "Successful Response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BookingResponse"
            }
          }
        }
      },
      "422": {
        "description": "Validation Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HTTPValidationError"
            }
          }
        }
      }
    },
    "security": [
      {
        "HTTPBearer": []
      }
    ]
  },
  "bookingCreateSchema": {
    "properties": {
      "vehicle_id": {
        "type": "integer",
        "title": "Vehicle Id"
      },
      "start_date": {
        "type": "string",
        "format": "date",
        "title": "Start Date"
      },
      "end_date": {
        "type": "string",
        "format": "date",
        "title": "End Date"
      },
      "pickup_location": {
        "type": "string",
        "maxLength": 255,
        "title": "Pickup Location",
        "examples": [
          "Delhi Airport"
        ]
      },
      "pickup_time": {
        "anyOf": [
          {
            "type": "string",
            "format": "time"
          },
          {
            "type": "null"
          }
        ],
        "title": "Pickup Time",
        "examples": [
          "10:00:00"
        ]
      },
      "drop_location": {
        "type": "string",
        "maxLength": 255,
        "title": "Drop Location",
        "examples": [
          "Gurugram"
        ]
      },
      "drop_time": {
        "anyOf": [
          {
            "type": "string",
            "format": "time"
          },
          {
            "type": "null"
          }
        ],
        "title": "Drop Time",
        "examples": [
          "18:00:00"
        ]
      },
      "total_amount": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Total Amount",
        "examples": [
          0
        ]
      },
      "discount_amount": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Discount Amount",
        "examples": [
          0
        ]
      },
      "payable_price": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Payable Price",
        "examples": [
          0
        ]
      },
      "coupon": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 100
          },
          {
            "type": "null"
          }
        ],
        "title": "Coupon",
        "examples": [
          "WELCOME10"
        ]
      }
    },
    "type": "object",
    "required": [
      "vehicle_id",
      "start_date",
      "end_date",
      "pickup_location",
      "drop_location"
    ],
    "title": "BookingCreate"
  },
